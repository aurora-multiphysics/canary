# Generated by gridded_fields.py. Converts axisymmetric source fields on
# the (R, Z) grid to a 2D ExodusII time series, with x = R and y = Z.
[Mesh]
  type = GeneratedMesh
  dim = 2
  nx = 42
  ny = 42
  xmin = 3.9500000000000002
  xmax = 6.0499999999999998
  ymin = -1.05
  ymax = 1.05
[]

[Problem]
  solve = false
[]

[AuxVariables]
  [dpsi_dt]
  []
  [b_r]
  []
  [b_z]
  []
  [b_phi]
  []
[]

[Functions]
  [dpsi_dt]
    type = PiecewiseMultilinear
    data_file = ramp_source_dpsi_dt.txt
  []
  [b_r]
    type = PiecewiseMultilinear
    data_file = ramp_source_b_r.txt
  []
  [b_z]
    type = PiecewiseMultilinear
    data_file = ramp_source_b_z.txt
  []
  [b_phi]
    type = PiecewiseMultilinear
    data_file = ramp_source_b_phi.txt
  []
[]

[AuxKernels]
  [dpsi_dt]
    type = FunctionAux
    variable = dpsi_dt
    function = dpsi_dt
    execute_on = 'INITIAL TIMESTEP_END'
  []
  [b_r]
    type = FunctionAux
    variable = b_r
    function = b_r
    execute_on = 'INITIAL TIMESTEP_END'
  []
  [b_z]
    type = FunctionAux
    variable = b_z
    function = b_z
    execute_on = 'INITIAL TIMESTEP_END'
  []
  [b_phi]
    type = FunctionAux
    variable = b_phi
    function = b_phi
    execute_on = 'INITIAL TIMESTEP_END'
  []
[]

[Executioner]
  type = Transient
  start_time = 0
  end_time = 10
  [TimeStepper]
    type = CSVTimeSequenceStepper
    file_name = ramp_source_times.csv
    column_name = time
  []
[]

[Outputs]
  exodus = true
[]
