[Tests]
  design = 'syntax/Problem/index.md'
  issues = '#108' # TODO: point at the issue/PR tracking the electromagnetic benchmark work
  [Electrical_Contact]
    requirement = 'The system shall compute the resistance of an electrical contact between two '
                  'coaxial rods of dissimilar metals, touching over a circular spot on their axis '
                  'and separated by an insulating gap elsewhere, using an axisymmetric H1 '
                  'electrostatic solve in which the contact conductance of a film over the spot is '
                  'modelled by a thin conducting layer,'
    [Filmed_Spot]
      type = 'CSVDiff'
      input = 'electrical_contact.i'
      csvdiff = 'OutputData/ElectricalContactCSV.csv
                 OutputData/ElectricalContactCSV_spot_current_density_0001.csv'
      cli_args = 'Outputs/ParaViewDataCollection/enable=false'
      capabilities = 'mfem'
      recover = false
      detail = 'for a film whose resistance is comparable to the constriction resistance of the '
               'spot, reproducing the resistance of the contact and the current density through '
               'the spot of a semi-analytic solution,'
    []
    [Clean_Spot]
      type = 'CSVDiff'
      input = 'electrical_contact.i'
      csvdiff = 'OutputData/ElectricalContactCleanCSV.csv'
      cli_args = 'contact_conductance=1e16
                  Outputs/ReportedPostprocessors/file_base=OutputData/ElectricalContactCleanCSV
                  Outputs/ParaViewDataCollection/enable=false'
      capabilities = 'mfem'
      recover = false
      detail = 'for a clean contact, reproducing the constriction resistance of an equipotential '
               'spot in a rod of finite radius, and'
    []
    [Full_Contact]
      type = 'CSVDiff'
      input = 'electrical_contact.i'
      csvdiff = 'OutputData/ElectricalContactFullCSV.csv
                 OutputData/ElectricalContactFullCSV_axial_potential_0001.csv'
      cli_args = 'Mesh/file=electrical_contact_full.e spot_radius=5e-3 contact_conductance=1e9
                  Outputs/ReportedPostprocessors/file_base=OutputData/ElectricalContactFullCSV
                  Outputs/ParaViewDataCollection/enable=false'
      capabilities = 'mfem'
      recover = false
      detail = 'for rods in contact over their whole faces, reproducing the exact one-dimensional '
               'resistance of the rods and the film in series.'
    []
  []
  [Electrical_Contact_Interface]
    requirement = 'The system shall compute the resistance of the same electrical contact with the '
                  'film over the spot imposed as a jump in potential across a surface of no '
                  'thickness, by an interface kernel coupling a potential on either side of it,'
    [Filmed_Spot]
      type = 'CSVDiff'
      input = 'electrical_contact_interface.i'
      csvdiff = 'OutputData/ElectricalContactInterfaceCSV.csv
                 OutputData/ElectricalContactInterfaceCSV_contact_plane_potential_0001.csv'
      cli_args = 'Outputs/ParaViewDataCollection/enable=false'
      capabilities = 'mfem'
      recover = false
      detail = 'for a film whose resistance is comparable to the constriction resistance of the '
               'spot, reproducing the resistance of the contact and the current density through '
               'the spot of a semi-analytic solution, and'
    []
    [Full_Contact]
      type = 'CSVDiff'
      input = 'electrical_contact_interface.i'
      csvdiff = 'OutputData/ElectricalContactInterfaceFullCSV.csv'
      cli_args = 'Mesh/file=electrical_contact_interface_full.e spot_radius=5e-3
                  contact_conductance=1e9
                  Outputs/ReportedPostprocessors/file_base=OutputData/ElectricalContactInterfaceFullCSV
                  Outputs/ParaViewDataCollection/enable=false'
      capabilities = 'mfem'
      recover = false
      detail = 'for rods in contact over their whole faces, reproducing the exact one-dimensional '
               'resistance of the rods and the film in series.'
    []
  []
[]
