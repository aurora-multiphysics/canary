# TEAM Problem 13: 3-D non-linear magnetostatic model
# ===================================================
#
# A racetrack coil drives flux up a central steel plate, across a 0.5 mm air gap
# and back down two steel channels whose open sides face the plate. The steel is
# driven into saturation, so the reluctivity depends on the local flux density and
# the problem is non-linear. The benchmark and the results are documented in
# doc/content/problems/team_problem_13.md.
#
# The mesh is built by team13_mesh.py and the steel's B-H curve is turned into the
# two long expressions below by bh_curve.py; neither is edited by hand.
#
# Formulation
# -----------
# Magnetic vector potential, B = curl(A), in H(curl):
#
#   (nu(|curl A|) curl A, curl A') = (J_s, A')
#
# with the reluctivity nu = H(B)/B taken from the benchmark's B-H curve inside the
# steel and 1/mu0 elsewhere. J_s is the coil current, solved for by the sub-app
# team13_coil_source.i so that it is discretely divergence free; see there for why
# projecting the analytic winding current directly is not good enough.
#
# Only the half of the model above z = 0 is meshed. Reflecting in that plane leaves
# the coil current unchanged, so B_z is even and B_x and B_y are odd there: the
# field is normal to the plane. That is the natural condition of this weak form,
# n x H = 0, so the symmetry plane is left free. The far-field faces carry
# n x A = 0, which is B.n = 0, holding the flux inside the box.
#
# The curl-curl operator has the gradients in its null space; the regularisation
# term in the Kernels block below removes them rather than the problem being gauged.

ampere_turns = 1000 # AT; the benchmark also specifies 3000 AT

plate_blocks = 'PlateZ000 PlateZ010 PlateZ020 PlateZ030 PlateZ040 PlateZ050 PlateZ060'
steel_blocks = '${plate_blocks} WebZ000 FlangeX060 Channel'
free_space_blocks = 'Air Coil'

vacuum_permeability = '${fparse 4 * pi * 1e-7}' # H/m
vacuum_reluctivity = '${fparse 1.0 / vacuum_permeability}' # m/H

[Mesh]
  type = MFEMFileMesh
  file = ./team13.e
[]

[Problem]
  type = MFEMProblem
[]

[Functions]
  # H(B) for the steel and its derivative, generated by bh_curve.py from the 27
  # tabulated points of the benchmark and its Eq. (1) above 1.8 T. Do not edit;
  # rerun bh_curve.py instead.
  [h_of_b]
    type = MFEMParsedFunction
    expression = 'if(B<0.0025,0+B*(6400+B*(170666.7+B*-6.826667e+07)),if(B<0.005,16+(B-0.0025)*(5973.333+(B-0.0025)*(234666.7+(B-0.0025)*-1.536e+08)),if(B<0.0125,30+(B-0.005)*(4266.667+(B-0.005)*(-279488.4+(B-0.005)*1.830216e+07)),if(B<0.025,54+(B-0.0125)*(3162.83+(B-0.0125)*(42889.55+(B-0.0125)*-3705276)),if(B<0.05,93+(B-0.025)*(2498.221+(B-0.025)*(-13857.65+(B-0.025)*-242847)),if(B<0.1,143+(B-0.05)*(1350+(B-0.05)*(-3254.28+(B-0.05)*-90914.41)),if(B<0.2,191+(B-0.1)*(342.714+(B-0.1)*(-2625.247+(B-0.1)*10981.08)),if(B<0.3,210+(B-0.2)*(147.0968+(B-0.2)*(-489.7616+(B-0.2)*2187.938)),if(B<0.4,222+(B-0.3)*(114.7826+(B-0.3)*(-227.6522+(B-0.3)*1798.261)),if(B<0.5,233+(B-0.4)*(123.2+(B-0.4)*(504+(B-0.4)*-3360)),if(B<0.6,247+(B-0.5)*(123.2+(B-0.5)*(-396+(B-0.5)*2640)),if(B<0.7,258+(B-0.6)*(123.2+(B-0.6)*(200.5161+(B-0.6)*-325.1613)),if(B<0.8,272+(B-0.7)*(153.5484+(B-0.7)*(38.78836+(B-0.7)*1257.278)),if(B<0.9,289+(B-0.8)*(199.0244+(B-0.8)*(593.0971+(B-0.8)*-1833.41)),if(B<1,313+(B-0.9)*(262.6415+(B-0.9)*(275.2948+(B-0.9)*-17.09906)),if(B<1.1,342+(B-1)*(317.1875+(B-1)*(-151.4423+(B-1)*4795.673)),if(B<1.2,377+(B-1.1)*(430.7692+(B-1.1)*(1736.131+(B-1.1)*-4438.228)),if(B<1.3,433+(B-1.2)*(644.8485+(B-1.2)*(76.05356+(B-1.2)*10754.62)),if(B<1.4,509+(B-1.3)*(982.6977+(B-1.3)*(3359.726+(B-1.3)*7132.975)),if(B<1.5,648+(B-1.4)*(1868.632+(B-1.4)*(8144.532+(B-1.4)*16691.48)),if(B<1.55,933+(B-1.5)*(3998.283+(B-1.5)*(27619.14+(B-1.5)*208304.1)),if(B<1.6,1228+(B-1.55)*(8322.478+(B-1.55)*(186147.1+(B-1.55)*-1403932)),if(B<1.65,1934+(B-1.6)*(16407.69+(B-1.6)*(-14052.93+(B-1.6)*1549982)),if(B<1.7,2913+(B-1.65)*(26627.26+(B-1.65)*(576338.8+(B-1.65)*-5537682)),if(B<1.75,4993+(B-1.7)*(42728.53+(B-1.7)*(39858.21+(B-1.7)*-320576.8)),if(B<1.8,7189+(B-1.75)*(44310.03+(B-1.75)*(-88044.23+(B-1.75)*1919691)),if(B>=2.219963,(B-2.158556)/1.256637e-06,2*(1.59-B)/(-2.452664e-05-sqrt(max(6.015559e-10-4*(-2.381e-10)*(1.59-B),0))))))))))))))))))))))))))))))'
    symbol_names = 'B'
    symbol_values = 'a_field_curl_mag'
  []
  [dh_db]
    type = MFEMParsedFunction
    expression = 'if(B<0.0025,6400+B*(341333.3+B*-2.048e+08),if(B<0.005,5973.333+(B-0.0025)*(469333.3+(B-0.0025)*-4.608e+08),if(B<0.0125,4266.667+(B-0.005)*(-558976.9+(B-0.005)*5.490649e+07),if(B<0.025,3162.83+(B-0.0125)*(85779.1+(B-0.0125)*-1.111583e+07),if(B<0.05,2498.221+(B-0.025)*(-27715.3+(B-0.025)*-728540.9),if(B<0.1,1350+(B-0.05)*(-6508.559+(B-0.05)*-272743.2),if(B<0.2,342.714+(B-0.1)*(-5250.495+(B-0.1)*32943.23),if(B<0.3,147.0968+(B-0.2)*(-979.5231+(B-0.2)*6563.815),if(B<0.4,114.7826+(B-0.3)*(-455.3043+(B-0.3)*5394.783),if(B<0.5,123.2+(B-0.4)*(1008+(B-0.4)*-10080),if(B<0.6,123.2+(B-0.5)*(-792+(B-0.5)*7920),if(B<0.7,123.2+(B-0.6)*(401.0323+(B-0.6)*-975.4839),if(B<0.8,153.5484+(B-0.7)*(77.57671+(B-0.7)*3771.833),if(B<0.9,199.0244+(B-0.8)*(1186.194+(B-0.8)*-5500.23),if(B<1,262.6415+(B-0.9)*(550.5896+(B-0.9)*-51.29717),if(B<1.1,317.1875+(B-1)*(-302.8846+(B-1)*14387.02),if(B<1.2,430.7692+(B-1.1)*(3472.261+(B-1.1)*-13314.69),if(B<1.3,644.8485+(B-1.2)*(152.1071+(B-1.2)*32263.85),if(B<1.4,982.6977+(B-1.3)*(6719.452+(B-1.3)*21398.92),if(B<1.5,1868.632+(B-1.4)*(16289.06+(B-1.4)*50074.43),if(B<1.55,3998.283+(B-1.5)*(55238.28+(B-1.5)*624912.3),if(B<1.6,8322.478+(B-1.55)*(372294.1+(B-1.55)*-4211797),if(B<1.65,16407.69+(B-1.6)*(-28105.86+(B-1.6)*4649946),if(B<1.7,26627.26+(B-1.65)*(1152678+(B-1.65)*-1.661305e+07),if(B<1.75,42728.53+(B-1.7)*(79716.43+(B-1.7)*-961730.4),if(B<1.8,44310.03+(B-1.75)*(-176088.5+(B-1.75)*5759073),if(B>=2.219963,795774.7,1/(2.452664e-05+2*(-2.381e-10)*(2*(1.59-B)/(-2.452664e-05-sqrt(max(6.015559e-10-4*(-2.381e-10)*(1.59-B),0))))))))))))))))))))))))))))))))'
    symbol_names = 'B'
    symbol_values = 'a_field_curl_mag'
  []
  # What the kernel actually asks for: the reluctivity nu = H/B, and B dnu/dB for
  # the Jacobian. Both are singular in form at B = 0 and finite in value there,
  # tending to H'(0) and to 0, so they are switched over to their limits below a
  # flux density far smaller than anything the steel carries. Dividing by a
  # floored B instead would put nu at zero where the field vanishes, which leaves
  # the steel with no reluctivity at all on the first Newton iteration.
  [steel_reluctivity]
    type = MFEMParsedFunction
    expression = 'if(B > 1e-6, h / B, dh)'
    symbol_names = 'h dh B'
    symbol_values = 'h_of_b dh_db a_field_curl_mag'
  []
  [steel_b_dnu_db]
    type = MFEMParsedFunction
    expression = 'if(B > 1e-6, dh - h / B, 0)'
    symbol_names = 'h dh B'
    symbol_values = 'h_of_b dh_db a_field_curl_mag'
  []
[]

[FunctorMaterials]
  [FreeSpace]
    type = MFEMGenericFunctorMaterial
    prop_names = reluctivity
    prop_values = ${vacuum_reluctivity}
    block = ${free_space_blocks}
  []
[]

[FESpaces]
  [HCurlFESpace]
    type = MFEMVectorFESpace
    fec_type = ND
    fec_order = FIRST
  []
  [H1FESpace]
    type = MFEMScalarFESpace
    fec_type = H1
    fec_order = FIRST
  []
  [HDivFESpace]
    type = MFEMVectorFESpace
    fec_type = RT
    fec_order = CONSTANT
  []
  [L2FESpace]
    type = MFEMScalarFESpace
    fec_type = L2
    fec_order = CONSTANT
  []
[]

[Variables]
  [a_field]
    type = MFEMVariable
    fespace = HCurlFESpace
  []
[]

[AuxVariables]
  # The two pieces of the coil current, from the sub-app. The first is the specified
  # winding current, integrated over the coil alone; the second is the correction
  # that makes their sum divergence free, and acts over the whole domain.
  [applied_current]
    type = MFEMVariable
    fespace = HCurlFESpace
  []
  [correction_potential]
    type = MFEMVariable
    fespace = H1FESpace
  []
  [b_field]
    type = MFEMVariable
    fespace = HDivFESpace
  []
  # |B|, taken straight from the curl of the solution rather than from b_field so
  # that it does not carry the extra projection error.
  [b_magnitude]
    type = MFEMVariable
    fespace = L2FESpace
  []
[]

[Kernels]
  # The curl-curl operator alone is singular: every gradient is in its null space,
  # so A is only determined up to one and the Newton iterates wander along it until
  # the curl is lost to cancellation. This term removes the null space rather than
  # gauging the problem. It is around six orders of magnitude below the curl-curl
  # term at the scale of this model, so it does not measurably perturb B: the
  # reported flux densities are unchanged to four decimal places over
  # 1 <= regularisation <= 1e4.
  #
  # Because the source is divergence free, there is nothing in the right hand side
  # for this term to absorb, and it leaves no gradient behind in A: int|A|^2 comes
  # out at 2.91e-9 whatever the coefficient. With the analytic current projected
  # straight onto the mesh it was 3.27e-1 and scaled as 1/coefficient^2, which is
  # what an incompatible right hand side looks like.
  [regularisation]
    type = MFEMVectorFEMassKernel
    variable = a_field
    coefficient = 1e2
  []
  [curl_curl_free_space]
    type = MFEMCurlCurlKernel
    variable = a_field
    coefficient = reluctivity
    block = ${free_space_blocks}
  []
  [curl_curl_steel]
    type = MFEMNLCurlCurlKernel
    variable = a_field
    k_coefficient = steel_reluctivity
    curlu_dk_dcurlu_coefficient = steel_b_dnu_db
    block = ${steel_blocks}
  []
  [coil_current]
    type = MFEMMixedVectorMassKernel
    variable = a_field
    trial_variable = applied_current
    coefficient = 1.0
    block = 'Coil'
  []
  [coil_current_correction]
    type = MFEMMixedVectorGradientKernel
    variable = a_field
    trial_variable = correction_potential
    coefficient = -1.0
  []
[]

[BCs]
  [tangential_a_far_field]
    type = MFEMVectorTangentialDirichletBC
    variable = a_field
    vector_coefficient = '0 0 0'
    boundary = 'far_field'
  []
[]

[AuxKernels]
  [update_b_field]
    type = MFEMCurlAux
    variable = b_field
    source = a_field
  []
  [update_b_magnitude]
    type = MFEMScalarProjectionAux
    variable = b_magnitude
    coefficient = a_field_curl_mag
  []
[]

[Solvers]
  [ams]
    type = MFEMHypreAMS
    fespace = HCurlFESpace
    # Not singular: the regularisation term above removes the null space. Saying
    # otherwise here costs AMS most of its effectiveness.
    singular = false
  []
  [pcg]
    type = MFEMHyprePCG
    preconditioner = ams
    l_tol = 1e-10
    l_max_its = 500
    print_level = 0
  []
  [newton]
    type = MFEMNewtonNonlinearSolver
    max_its = 50
    abs_tol = 1e-8
    rel_tol = 1e-7
    print_level = 1
  []
[]

[MultiApps]
  # The coil current has no dependence on the solution, so it is solved for once.
  [coil_source]
    type = FullSolveMultiApp
    input_files = team13_coil_source.i
    cli_args = 'ampere_turns=${ampere_turns}'
    execute_on = INITIAL
  []
[]

[Transfers]
  [from_coil_source]
    type = MultiAppMFEMCopyTransfer
    source_variables = 'applied_current correction_potential'
    variables = 'applied_current correction_potential'
    from_multi_app = coil_source
  []
[]

[Executioner]
  type = MFEMSteady
  device = cpu
[]

[Postprocessors]
  # Table 1 of the problem statement reports the average flux density in the
  # steel over a set of sections. The steel is meshed so that each measured
  # section has a block of its own centred on it, and these are the average of
  # |B| over those blocks.
  #
  # Positions 1 to 7, up the centre plate. The block for z = 0 is the top half of
  # its band, the rest lying below the symmetry plane, and the block for z = 60
  # runs from 55 mm to the top of the plate at 63.2 mm rather than being centred.
  [PlateB000]
    type = MFEMElementAverageValue
    variable = b_magnitude
    block = 'PlateZ000'
  []
  [PlateB010]
    type = MFEMElementAverageValue
    variable = b_magnitude
    block = 'PlateZ010'
  []
  [PlateB020]
    type = MFEMElementAverageValue
    variable = b_magnitude
    block = 'PlateZ020'
  []
  [PlateB030]
    type = MFEMElementAverageValue
    variable = b_magnitude
    block = 'PlateZ030'
  []
  [PlateB040]
    type = MFEMElementAverageValue
    variable = b_magnitude
    block = 'PlateZ040'
  []
  [PlateB050]
    type = MFEMElementAverageValue
    variable = b_magnitude
    block = 'PlateZ050'
  []
  [PlateB060]
    type = MFEMElementAverageValue
    variable = b_magnitude
    block = 'PlateZ060'
  []

  # Position 25, the foot of the web of the channel, and position 14, halfway
  # along its top flange.
  [WebB000]
    type = MFEMElementAverageValue
    variable = b_magnitude
    block = 'WebZ000'
  []
  [FlangeB060]
    type = MFEMElementAverageValue
    variable = b_magnitude
    block = 'FlangeX060'
  []
[]

[Outputs]
  [ReportedPostprocessors]
    type = CSV
    file_base = OutputData/TEAM13CSV
  []
  [ParaViewDataCollection]
    type = MFEMParaViewDataCollection
    file_base = OutputData/TEAM13
  []
[]
