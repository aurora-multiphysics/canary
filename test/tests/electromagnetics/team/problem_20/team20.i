# TEAM Problem 20: 3-D static force problem
# =========================================
#
# A coil wound round a steel centre pole drives flux up the pole, across into the
# top plates of a steel yoke, down its two legs and back across a 1.5 mm air gap
# into the foot of the pole. The benchmark asks for the force on the pole, at
# excitations from 1000 AT, where the steel is far from saturation, to 5000 AT,
# where the pole is well into it. The benchmark and the results are documented in
# doc/content/problems/team_problem_20.md.
#
# The mesh is built by team20_mesh.py and the steel's B-H curve is turned into the
# two long expressions below by bh_curve.py; neither is edited by hand.
#
# Formulation
# -----------
# Magnetic vector potential, B = curl(A), in H(curl):
#
#   (nu(|curl A|) curl A, curl A') = (J_s, A')
#
# with the reluctivity nu = H(B)/B taken from the benchmark's B-H curve inside the
# steel and 1/mu0 elsewhere. J_s is the coil current, solved for by the sub-app
# team20_coil_source.i so that it is discretely divergence free.
#
# Only the quarter of the model with x >= 0 and y >= 0 is meshed. Both planes
# contain the axis of the coil and the field lies in them, B.n = 0, which is
# n x A = 0: the same condition as on the far-field faces, holding the flux inside
# the box. All three carry it.
#
# The curl-curl operator has the gradients in its null space; the regularisation
# term in the Kernels block below removes them rather than the problem being gauged.
#
# The force
# ---------
# The force on the pole is the Maxwell stress integrated over a closed surface in
# the air around it. Taken over a single surface that is sensitive to exactly
# where the surface cuts the mesh, so it is spread instead over a thin shell of air
# with a weight g that is 1 on the pole and falls to 0 across the shell:
#
#   F = -int T . grad(g) dV,    T = (B B - |B|^2 I / 2) / mu0,
#
# which is the surface integral averaged over the level sets of g, and is the same
# thing as Coulomb's virtual work when the shell is one element thick. Its z
# component, the one asked for, is
#
#   F_z = int (|B|^2 / 2 mu0) dg/dz dV - int (B_z / mu0) B . grad(g) dV,
#
# the two terms below, times four for the four quarters of the pole.

ampere_turns = 1000 # AT; the benchmark also specifies 3000, 4500 and 5000 AT

# Order of the H(curl) space the vector potential lives in. The scalar space takes
# the same order, since its gradients have to lie in the H(curl) one for the coil
# source and the null space to line up. B is a curl and so drops an order, which is
# what flux_order is for: the H(div) and L2 spaces carrying the derived fields.
# FIRST/CONSTANT and SECOND/FIRST are the two pairings that make sense.
fe_order = FIRST
flux_order = CONSTANT

# The mesh, which the coil source sub-app reads too. team20_mesh.py writes others
# for the convergence study in the documentation.
mesh_file = team20.e

# Every measurement block is steel and has to appear here: the reluctivity and the
# non-linear curl-curl kernel are applied to steel_blocks, and a block left out of
# it gets no curl-curl term at all, which makes the field there diverge.
steel_blocks = 'Pole PoleZ075 Yoke YokeZ075'
free_space_blocks = 'Air Coil'

vacuum_permeability = '${fparse 4 * pi * 1e-7}' # H/m
vacuum_reluctivity = '${fparse 1.0 / vacuum_permeability}' # m/H

# The pole, x <= 12.5 mm, y <= 5 mm, 26.5 <= z <= 125 mm in the quarter, and the
# thickness of the shell of air the force is taken over. The shell has to stay
# clear of the yoke, which comes within 1 mm of the top corner of the pole.
pole_half_x = 0.0125 # m
pole_half_y = 0.005 # m
pole_z0 = 0.0265 # m
pole_z1 = 0.125 # m
force_shell = 0.0009 # m

[Mesh]
  type = MFEMFileMesh
  file = ${mesh_file}
[]

[Problem]
  type = MFEMProblem
[]

[Functions]
  # H(B) for the steel and its derivative, generated by bh_curve.py from the 38
  # tabulated points of the benchmark and its Eq. (1) above 2.3 T. Do not edit;
  # rerun bh_curve.py instead.
  [h_of_b]
    type = MFEMParsedFunction
    expression = 'if(B<0.01,0+B*(2700+B*(33781.75+B*-3378175)),if(B<0.025,27+(B-0.01)*(2362.183+(B-0.01)*(-26254.9+(B-0.01)*436923.3)),if(B<0.05,58+(B-0.025)*(1869.459+(B-0.025)*(-1291.794+(B-0.025)*-251462)),if(B<0.1,100+(B-0.05)*(1333.378+(B-0.05)*(-5697.461+(B-0.05)*4598.14)),if(B<0.15,153+(B-0.1)*(798.1176+(B-0.1)*(-3370.86+(B-0.1)*4170.136)),if(B<0.2,185+(B-0.15)*(492.3077+(B-0.15)*(-2412.308+(B-0.15)*11323.08)),if(B<0.3,205+(B-0.2)*(336+(B-0.2)*(-784+(B-0.2)*2240)),if(B<0.4,233+(B-0.3)*(246.4+(B-0.3)*(-866.4615+(B-0.3)*6024.615)),if(B<0.5,255+(B-0.4)*(253.8462+(B-0.4)*(692.3077+(B-0.4)*-2307.692)),if(B<0.6,285+(B-0.5)*(323.0769+(B-0.5)*(538.4615+(B-0.5)*-2692.308)),if(B<0.7,320+(B-0.6)*(350+(B-0.6)*(-617.6471+(B-0.6)*6176.471)),if(B<0.8,355+(B-0.7)*(411.7647+(B-0.7)*(1112.532+(B-0.7)*-2301.79)),if(B<0.9,405+(B-0.8)*(565.2174+(B-0.8)*(828.9855+(B-0.8)*188.4058)),if(B<1,470+(B-0.9)*(736.6667+(B-0.9)*(884.8933+(B-0.9)*2484.401)),if(B<1.1,555+(B-1)*(988.1773+(B-1)*(1946.773+(B-1)*-285.4689)),if(B<1.2,673+(B-1.1)*(1368.968+(B-1.1)*(2476.253+(B-1.1)*1340.675)),if(B<1.3,836+(B-1.2)*(1904.439+(B-1.2)*(3822.545+(B-1.2)*330.67)),if(B<1.35,1065+(B-1.3)*(2678.868+(B-1.3)*(8986.128+(B-1.3)*-11269.73)),if(B<1.4,1220+(B-1.35)*(3492.958+(B-1.35)*(4281.69+(B-1.35)*117183.1)),if(B<1.45,1420+(B-1.4)*(4800+(B-1.4)*(29408.45+(B-1.4)*-108169)),if(B<1.5,1720+(B-1.45)*(6929.577+(B-1.45)*(28374.8+(B-1.45)*-59326.91)),if(B<1.55,2130+(B-1.5)*(9322.105+(B-1.5)*(15915.79+(B-1.5)*272842.1)),if(B<1.6,2670+(B-1.55)*(12960+(B-1.55)*(92419.67+(B-1.55)*-552393.4)),if(B<1.65,3480+(B-1.6)*(18059.02+(B-1.6)*(22611+(B-1.6)*484173.4)),if(B<1.7,4500+(B-1.65)*(23951.42+(B-1.65)*(155911.6+(B-1.65)*-1098798)),if(B<1.75,5950+(B-1.7)*(31301.59+(B-1.7)*(-14955.06+(B-1.7)*1378466)),if(B<1.8,7650+(B-1.75)*(40144.58+(B-1.75)*(271787+(B-1.75)*-1893571)),if(B<1.85,10100+(B-1.8)*(53121.5+(B-1.8)*(195140.2+(B-1.8)*-1951402)),if(B<1.9,13000+(B-1.85)*(58000+(B-1.85)*(-329382.7+(B-1.85)*6587654)),if(B<1.95,15900+(B-1.9)*(74469.14+(B-1.9)*(1181235+(B-1.9)*-1.181235e+07)),if(B<2,21100+(B-1.95)*(104000+(B-1.95)*(-246779.7+(B-1.95)*4935593)),if(B<2.05,26300+(B-2)*(116339+(B-2)*(111318.7+(B-2)*4038032)),if(B<2.1,32900+(B-2.05)*(157756.1+(B-2.05)*(277533.9+(B-2.05)*9746883)),if(B<2.15,42700+(B-2.1)*(258611.1+(B-2.1)*(4197863+(B-2.1)*-3.540171e+07)),if(B<2.2,61700+(B-2.15)*(412884.6+(B-2.15)*(984408.3+(B-2.15)*-4042013)),if(B<2.25,84300+(B-2.2)*(481010.4+(B-2.2)*(1461519+(B-2.2)*-1.603452e+07)),if(B<2.3,110000+(B-2.25)*(506903.4+(B-2.25)*(-6191628+(B-2.25)*1.210712e+08)),(B-2.130354)/1.256637e-06)))))))))))))))))))))))))))))))))))))'
    symbol_names = 'B'
    symbol_values = 'a_field_curl_mag'
  []
  [dh_db]
    type = MFEMParsedFunction
    expression = 'if(B<0.01,2700+B*(67563.5+B*-1.013452e+07),if(B<0.025,2362.183+(B-0.01)*(-52509.81+(B-0.01)*1310770),if(B<0.05,1869.459+(B-0.025)*(-2583.588+(B-0.025)*-754385.9),if(B<0.1,1333.378+(B-0.05)*(-11394.92+(B-0.05)*13794.42),if(B<0.15,798.1176+(B-0.1)*(-6741.719+(B-0.1)*12510.41),if(B<0.2,492.3077+(B-0.15)*(-4824.615+(B-0.15)*33969.23),if(B<0.3,336+(B-0.2)*(-1568+(B-0.2)*6720),if(B<0.4,246.4+(B-0.3)*(-1732.923+(B-0.3)*18073.85),if(B<0.5,253.8462+(B-0.4)*(1384.615+(B-0.4)*-6923.077),if(B<0.6,323.0769+(B-0.5)*(1076.923+(B-0.5)*-8076.923),if(B<0.7,350+(B-0.6)*(-1235.294+(B-0.6)*18529.41),if(B<0.8,411.7647+(B-0.7)*(2225.064+(B-0.7)*-6905.371),if(B<0.9,565.2174+(B-0.8)*(1657.971+(B-0.8)*565.2174),if(B<1,736.6667+(B-0.9)*(1769.787+(B-0.9)*7453.202),if(B<1.1,988.1773+(B-1)*(3893.547+(B-1)*-856.4066),if(B<1.2,1368.968+(B-1.1)*(4952.506+(B-1.1)*4022.024),if(B<1.3,1904.439+(B-1.2)*(7645.09+(B-1.2)*992.01),if(B<1.35,2678.868+(B-1.3)*(17972.26+(B-1.3)*-33809.19),if(B<1.4,3492.958+(B-1.35)*(8563.38+(B-1.35)*351549.3),if(B<1.45,4800+(B-1.4)*(58816.9+(B-1.4)*-324507),if(B<1.5,6929.577+(B-1.45)*(56749.59+(B-1.45)*-177980.7),if(B<1.55,9322.105+(B-1.5)*(31831.58+(B-1.5)*818526.3),if(B<1.6,12960+(B-1.55)*(184839.3+(B-1.55)*-1657180),if(B<1.65,18059.02+(B-1.6)*(45222.01+(B-1.6)*1452520),if(B<1.7,23951.42+(B-1.65)*(311823.1+(B-1.65)*-3296395),if(B<1.75,31301.59+(B-1.7)*(-29910.12+(B-1.7)*4135399),if(B<1.8,40144.58+(B-1.75)*(543573.9+(B-1.75)*-5680712),if(B<1.85,53121.5+(B-1.8)*(390280.4+(B-1.8)*-5854206),if(B<1.9,58000+(B-1.85)*(-658765.4+(B-1.85)*1.976296e+07),if(B<1.95,74469.14+(B-1.9)*(2362469+(B-1.9)*-3.543704e+07),if(B<2,104000+(B-1.95)*(-493559.3+(B-1.95)*1.480678e+07),if(B<2.05,116339+(B-2)*(222637.5+(B-2)*1.21141e+07),if(B<2.1,157756.1+(B-2.05)*(555067.8+(B-2.05)*2.924065e+07),if(B<2.15,258611.1+(B-2.1)*(8395726+(B-2.1)*-1.062051e+08),if(B<2.2,412884.6+(B-2.15)*(1968817+(B-2.15)*-1.212604e+07),if(B<2.25,481010.4+(B-2.2)*(2923038+(B-2.2)*-4.810355e+07),if(B<2.3,506903.4+(B-2.25)*(-1.238326e+07+(B-2.25)*3.632137e+08),795774.7)))))))))))))))))))))))))))))))))))))'
    symbol_names = 'B'
    symbol_values = 'a_field_curl_mag'
  []
  # What the kernel actually asks for: the reluctivity nu = H/B, and B dnu/dB for
  # the Jacobian. Both are singular in form at B = 0 and finite in value there,
  # tending to H'(0) and to 0, so they are switched over to their limits below a
  # flux density far smaller than anything the steel carries. Dividing by a
  # floored B instead would put nu at zero where the field vanishes, which leaves
  # the steel with no reluctivity at all on the first Newton iteration.
  [steel_reluctivity]
    type = MFEMParsedFunction
    expression = 'if(B > 1e-6, h / B, dh)'
    symbol_names = 'h dh B'
    symbol_values = 'h_of_b dh_db a_field_curl_mag'
  []
  [steel_b_dnu_db]
    type = MFEMParsedFunction
    expression = 'if(B > 1e-6, dh - h / B, 0)'
    symbol_names = 'h dh B'
    symbol_values = 'h_of_b dh_db a_field_curl_mag'
  []

  # The weight the force is taken with: 1 on the pole, falling linearly to 0 with
  # distance d from it across a shell force_shell thick. Interpolated onto the
  # lowest order H1 space, so that it is exactly 1 at every node of the pole and
  # exactly 0 at every node of the yoke and the coil.
  [force_weight_function]
    type = MFEMParsedFunction
    expression = 'max(0, 1 - sqrt(max(x - hx, 0)^2 + max(y - hy, 0)^2
                                  + (max(z0 - z, 0) + max(z - z1, 0))^2) / delta)'
    symbol_names = 'hx hy z0 z1 delta'
    symbol_values = '${pole_half_x} ${pole_half_y} ${pole_z0} ${pole_z1} ${force_shell}'
  []
  # The two pieces of the integrand that multiply grad(g).
  [stress_bz]
    type = MFEMParsedFunction
    expression = 'bz * nu0'
    symbol_names = 'bz nu0'
    symbol_values = 'b_z ${vacuum_reluctivity}'
  []
  [magnetic_pressure]
    type = MFEMParsedFunction
    expression = '0.5 * B * B * nu0'
    symbol_names = 'B nu0'
    symbol_values = 'a_field_curl_mag ${vacuum_reluctivity}'
  []
[]

[FunctorMaterials]
  [FreeSpace]
    type = MFEMGenericFunctorMaterial
    prop_names = reluctivity
    prop_values = ${vacuum_reluctivity}
    block = ${free_space_blocks}
  []
[]

[FESpaces]
  [HCurlFESpace]
    type = MFEMVectorFESpace
    fec_type = ND
    fec_order = ${fe_order}
  []
  [H1FESpace]
    type = MFEMScalarFESpace
    fec_type = H1
    fec_order = ${fe_order}
  []
  [HDivFESpace]
    type = MFEMVectorFESpace
    fec_type = RT
    fec_order = ${flux_order}
  []
  [L2FESpace]
    type = MFEMScalarFESpace
    fec_type = L2
    fec_order = ${flux_order}
  []
  # The force weight is interpolated at the vertices only, whatever fe_order is,
  # so that it is 1 on the pole and 0 on the other parts at every node it has.
  [WeightFESpace]
    type = MFEMScalarFESpace
    fec_type = H1
    fec_order = FIRST
  []
[]

[Variables]
  [a_field]
    type = MFEMVariable
    fespace = HCurlFESpace
  []
[]

[AuxVariables]
  # The two pieces of the coil current, from the sub-app. The first is the specified
  # winding current, integrated over the coil alone; the second is the correction
  # that makes their sum divergence free, and acts over the whole domain.
  [applied_current]
    type = MFEMVariable
    fespace = HCurlFESpace
  []
  [correction_potential]
    type = MFEMVariable
    fespace = H1FESpace
  []
  [b_field]
    type = MFEMVariable
    fespace = HDivFESpace
  []
  # |B| and the components the benchmark reports, taken straight from the curl of
  # the solution. In these L2 spaces they are exact, the curl dropping an order.
  [b_magnitude]
    type = MFEMVariable
    fespace = L2FESpace
  []
  [b_x]
    type = MFEMVariable
    fespace = L2FESpace
  []
  [b_z]
    type = MFEMVariable
    fespace = L2FESpace
  []
  # The force weight g, its gradient, and the unit vector dg/dz is taken along.
  # The gradient of a lowest order H1 field lies in the lowest order H(curl) space,
  # which the higher order ones contain, so it is held exactly.
  [force_weight]
    type = MFEMVariable
    fespace = WeightFESpace
  []
  [force_weight_gradient]
    type = MFEMVariable
    fespace = HCurlFESpace
  []
  [z_direction]
    type = MFEMVariable
    fespace = HCurlFESpace
  []
[]

[Kernels]
  # The curl-curl operator alone is singular: every gradient is in its null space,
  # so A is only determined up to one and the Newton iterates wander along it until
  # the curl is lost to cancellation. This term removes the null space rather than
  # gauging the problem. It is many orders of magnitude below the curl-curl term at
  # the scale of this model, and because the source is divergence free there is
  # nothing in the right hand side for it to absorb.
  [regularisation]
    type = MFEMVectorFEMassKernel
    variable = a_field
    coefficient = 1e2
  []
  [curl_curl_free_space]
    type = MFEMCurlCurlKernel
    variable = a_field
    coefficient = reluctivity
    block = ${free_space_blocks}
  []
  [curl_curl_steel]
    type = MFEMNLCurlCurlKernel
    variable = a_field
    k_coefficient = steel_reluctivity
    curlu_dk_dcurlu_coefficient = steel_b_dnu_db
    block = ${steel_blocks}
  []
  # These two terms are written on the left hand side of the residual, so they
  # carry the opposite sign to the current: together they apply
  # J = J_applied - grad(phi), the anticlockwise current that drives flux up the pole.
  [coil_current]
    type = MFEMMixedVectorMassKernel
    variable = a_field
    trial_variable = applied_current
    coefficient = -1.0
    block = 'Coil'
  []
  [coil_current_correction]
    type = MFEMMixedVectorGradientKernel
    variable = a_field
    trial_variable = correction_potential
    coefficient = 1.0
  []
[]

[BCs]
  [tangential_a_zero]
    type = MFEMVectorTangentialDirichletBC
    variable = a_field
    vector_coefficient = '0 0 0'
    boundary = 'far_field symmetry_x symmetry_y'
  []
[]

[AuxKernels]
  [update_b_field]
    type = MFEMCurlAux
    variable = b_field
    source = a_field
  []
  [update_b_magnitude]
    type = MFEMScalarProjectionAux
    variable = b_magnitude
    coefficient = a_field_curl_mag
  []
  [update_b_x]
    type = MFEMInnerProductAux
    variable = b_x
    first_source_vec = a_field_curl
    second_source_vec = '1 0 0'
  []
  [update_b_z]
    type = MFEMInnerProductAux
    variable = b_z
    first_source_vec = a_field_curl
    second_source_vec = '0 0 1'
  []
  [project_force_weight]
    type = MFEMScalarProjectionAux
    variable = force_weight
    coefficient = force_weight_function
  []
  [update_force_weight_gradient]
    type = MFEMGradAux
    variable = force_weight_gradient
    source = force_weight
  []
  [project_z_direction]
    type = MFEMVectorProjectionAux
    variable = z_direction
    vector_coefficient = '0 0 1'
  []
[]

[Solvers]
  [ams]
    type = MFEMHypreAMS
    fespace = HCurlFESpace
    # Not singular: the regularisation term above removes the null space. Saying
    # otherwise here costs AMS most of its effectiveness.
    singular = false
  []
  [pcg]
    type = MFEMHyprePCG
    preconditioner = ams
    l_tol = 1e-10
    l_max_its = 500
    print_level = 0
  []
  [newton]
    type = MFEMNewtonNonlinearSolver
    max_its = 50
    abs_tol = 1e-8
    rel_tol = 1e-7
    print_level = 1
    # Not needed here: every excitation converges in four to ten iterations with or
    # without it, to the same answer. It is kept as cheap insurance against the
    # limit cycle an undamped update can fall into at the knee of the B-H curve,
    # which TEAM Problem 13 showed on finer meshes and at higher order.
    line_search = backtracking
  []
[]

[MultiApps]
  # The coil current has no dependence on the solution, so it is solved for once.
  [coil_source]
    type = FullSolveMultiApp
    input_files = team20_coil_source.i
    cli_args = 'ampere_turns=${ampere_turns};fe_order=${fe_order};mesh_file=${mesh_file}'
    execute_on = INITIAL
  []
[]

[Transfers]
  [from_coil_source]
    type = MultiAppMFEMCopyTransfer
    source_variables = 'applied_current correction_potential'
    variables = 'applied_current correction_potential'
    from_multi_app = coil_source
  []
[]

[Executioner]
  type = MFEMSteady
  device = cpu
[]

[Postprocessors]
  # Table 5 of the problem statement: the z component of the force on the pole. The
  # two terms of the shell integral over the quarter model, then the force on the
  # whole pole. A positive force is upwards.
  [force_pressure_term]
    type = MFEMVectorFEInnerProductIntegralPostprocessor
    execute_on = FINAL
    primal_variable = force_weight_gradient
    dual_variable = z_direction
    coefficient = magnetic_pressure
    outputs = none
  []
  [force_tension_term]
    type = MFEMVectorFEInnerProductIntegralPostprocessor
    execute_on = FINAL
    primal_variable = force_weight_gradient
    dual_variable = b_field
    coefficient = stress_bz
    outputs = none
  []
  [PoleForceZ]
    type = ParsedPostprocessor
    execute_on = FINAL
    expression = '4 * (pressure - tension)'
    pp_names = 'force_pressure_term force_tension_term'
    pp_symbols = 'pressure tension'
  []

  # Table 3: the average Bz over the section of the pole (alpha-beta) and of the
  # yoke leg (gamma-delta) at z = 75 mm. Each has a block of its own in the mesh, a
  # 5 mm band centred on the section.
  [PoleBzZ075]
    type = MFEMElementAverageValue
    variable = b_z
    block = 'PoleZ075'
  []
  [YokeBzZ075]
    type = MFEMElementAverageValue
    variable = b_z
    block = 'YokeZ075'
  []
[]

[VectorPostprocessors]
  # Table 2: Bz in the gap under the pole, at P1 on its axis and P2 under its corner.
  [gap_points]
    type = MFEMVariablePointValueSampler
    variable = b_z
    points = '0.0    0.0   0.02575
              0.0125 0.005 0.02575'
  []
  # Table 4: Bx in the air at the top corner of the pole, along a-b (x = 13 mm,
  # y = 4 mm, z = 120 to 130 mm) and c-d (x = 13 mm, z = 125 mm, y = 0 to 13 mm).
  [line_ab]
    type = MFEMVariablePointValueSampler
    variable = b_x
    points = '0.013 0.004 0.120  0.013 0.004 0.121  0.013 0.004 0.122  0.013 0.004 0.123
              0.013 0.004 0.124  0.013 0.004 0.125  0.013 0.004 0.126  0.013 0.004 0.127
              0.013 0.004 0.128  0.013 0.004 0.129  0.013 0.004 0.130'
  []
  [line_cd]
    type = MFEMVariablePointValueSampler
    variable = b_x
